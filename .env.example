# Copy to .env for LOCAL runs only. On GitHub, add these as repository secrets instead.
# Never commit real values.
SHORTS_MODE=dry_run              # dry_run | live
ANTHROPIC_API_KEY=               # console.anthropic.com -> API keys
ELEVENLABS_API_KEY=              # elevenlabs.io -> Developers -> API keys
BFL_API_KEY=                     # dashboard.bfl.ai -> API keys (FLUX images)
YT_CLIENT_ID=                    # Google Cloud -> APIs & Services -> Credentials (OAuth client, Desktop app)
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=                # printed by scripts/youtube_auth.py
